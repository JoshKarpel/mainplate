#!/usr/bin/env bash
# How a mainplate session gets this repository ready to work in.
#
# A repository-tier plugin, run once per session at `setup`, behind the sandbox and with a network.
# It is a plugin that **prints nothing**: it names no events, so it is asked nothing again, and it
# never parses the payload it is handed. Nothing here imports mainplate or reads the protocol; what
# this knows is the toolchain, and what the console knows is when and where to run it.
#
# **It installs into `$MAINPLATE_SCRATCH` and not into its own `$HOME`.** That directory is the
# session's own scratch, bound read-write at this one event, and it is what every command in the
# session gets as *its* `$HOME` - so everything fetched below is where a later `just test` looks for
# it. `$HOME` in here is this plugin's own directory, which the session's commands cannot see, so the
# line below points the tools that fetch at the right one.
#
# **Through mise, so the tools are the ones `mise.toml` pins.** The namespace has `/usr` and nothing
# of the machine's, so `just` and `uv` both have to be fetched, and mise is what fetches the
# versions this repository declares rather than whatever an installer happens to serve. mise itself
# is fetched first, into `$HOME/.local/bin`, and its shims are what put the tools on `PATH`: there
# is no shell rc to `mise activate` in, and a shims directory works in a `sh -c`.
#
# **`just dependencies` and not `just setup`**, because the other half of `setup` installs a git
# hook, and git's hooks live in the clone's common directory, shared by every worktree of it and
# bound read-only here. That line is a person's to run, once per clone, from the composer's `Run`.
#
# **What crosses back to the session is what is appended to `$MAINPLATE_ENV`**, one `KEY=value` per
# line, and nothing else in this environment does. `PATH` is set whole: the shims first, so a `uv`
# or a `just` is the pinned one, then mise's own directory, then the system's.

set -euo pipefail

# **Everything below prints to stderr.** stdout is where a plugin's answer goes, and this one answers
# nothing, so a line of progress from `curl`, `mise` or `just` on the way past would be a plugin that
# printed something the console cannot read. Sent the other way it is diagnostics, which is what it
# is, and the console logs it.
exec 1>&2

# Everything below fetches, and everything that fetches keeps what it fetched under `$HOME`. Pointed
# at the session's scratch so that is where all of it lands, which is the one line in here that knows
# this plugin is installing for somebody else's commands rather than for its own.
export HOME="$MAINPLATE_SCRATCH"

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise >/dev/null; then
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
fi

# `mise install` reads `mise.toml` from the working directory, which is the worktree root. The
# config is this repository's own and the session already chose to run its code, so trusting it is
# stating what has been decided rather than deciding anything.
mise trust --quiet
mise install --quiet

SHIMS="$HOME/.local/share/mise/shims"
export PATH="$SHIMS:$PATH"

just dependencies

echo "PATH=$PATH" >> "$MAINPLATE_ENV"
