#!/usr/bin/env bash
# How a mainplate session gets this repository ready to work in.
#
# Run once per session by the console, behind the sandbox, with a network, and with `$HOME` the
# session's own scratch: everything fetched below lands there, which is where the session's commands
# find it. Nothing here imports mainplate or reads the plugin protocol; what this knows is the
# toolchain, and what the console knows is when and where to run it.
#
# **Through mise, so the tools are the ones `mise.toml` pins.** The namespace has `/usr` and nothing
# of the machine's, so `just`, `node` and `uv` all have to be fetched, and mise is what fetches the
# versions this repository declares rather than whatever an installer happens to serve. mise itself
# is fetched first, into `$HOME/.local/bin`, and its shims are what put the tools on `PATH`: there
# is no shell rc to `mise activate` in, and a shims directory works in a `sh -c`.
#
# **`just dependencies` and not `just setup`**, because the other half of `setup` installs a git
# hook, and git's hooks live in the clone's common directory, shared by every worktree of it and
# bound read-only here. That line is a person's to run, once per clone, from the composer's `Run`.
#
# **What crosses back to the session is what is appended to `$MAINPLATE_ENV`**, one `KEY=value` per
# line, and nothing else in this environment does. `PATH` is set whole: the shims first, so a `uv`
# or a `node` is the pinned one, then mise's own directory, then the system's.

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise >/dev/null; then
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
fi

# `mise install` reads `mise.toml` from the working directory, which is the worktree root. The
# config is this repository's own and the session already chose to run its code, so trusting it is
# stating what has been decided rather than deciding anything.
mise trust --quiet
mise install --quiet

SHIMS="$HOME/.local/share/mise/shims"
export PATH="$SHIMS:$PATH"

just dependencies

echo "PATH=$PATH" >> "$MAINPLATE_ENV"
