      "additionalProperties": false,
      "description": "A control on this plugin's card was pressed, with the value it now holds.",
      "properties": {
        "event": {
          "const": "action",
          "title": "Event",
          "type": "string"
        },
        "session": {
          "title": "Session",
          "type": "string"
        },
        "plugin": {
          "title": "Plugin",
          "type": "string"
        },
        "settings": {
          "additionalProperties": {
            "$ref": "#/$defs/Setting"
          },
          "title": "Settings",
          "type": "object"
        },
        "checkout": {
          "title": "Checkout",
          "type": "string"
        },
        "scratch": {
          "title": "Scratch",
          "type": "string"
        },
        "state": {
          "additionalProperties": true,
          "title": "State",
          "type": "object"
        },
        "control": {
          "title": "Control",
          "type": "string"
        },
        "value": {
