#!/usr/bin/env python3
# What a session is told, and the guidance handed over as the model reaches for the files it covers.
#
# Two scopes, and the difference between them is whose voice it is rather than where the file sits.
# **Console guidance** is the operator's own, in `<config home>/mainplate/guidance/`, and it is true
# of every session this console answers. **Repository guidance** is the project's own `AGENTS.md`,
# read out of the worktree the session works in, and it is true of one repository.
#
# Each scope has a part that is always said and a part held back until it applies. The operator's
# files with no `paths:` and the repository's root `AGENTS.md` are in the instructions from the
# first request; an operator's file naming its globs, and an `AGENTS.md` further down the tree, are
# listed there by name and handed over whole the first time a file tool names a file they cover.
#
# **Nothing read out of a worktree follows a link.** This plugin runs as the operator, outside every
# sandbox, and everything in a worktree, its `.git` included, is the session's to write; see
# `beneath`.
#
# **The repository wins where the two disagree**, so it is composed last. That is not a claim about
# trust: it is that a repository is right about itself, which is the local-conventions rule said one
# layer out. What the console holds is how to work; what the repository holds is what this project is.
#
# `AGENTS.md` and not a name of this console's own, because a file only mainplate can read is
# knowledge that does not survive turning mainplate off. Every other harness reads that one, so a
# line written there keeps working when the tool is gone.
#
# **It is the other half of what the protocol has to carry**, which is why it ships beside `handoff`:
# between them the two exercise every event, every effect and every contribution. This one is
# `instructions` at `setup` and an `inject` at `before_request`, and nothing else.
#
# Nothing here imports mainplate. A bundled plugin runs on exactly the path a third-party plugin runs
# on, so what ships is a worked example rather than a privileged one - and the price is stated: the
# frontmatter readers below understand a `description:` line and the two shapes of a `paths:` list
# rather than YAML, and the globs are a small translator rather than a library, because a plugin
# with no dependencies is worth more here than the general case of fields nothing else reads.

from __future__ import annotations

import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Any

GUIDANCE_NAMES = ("AGENTS.md", "CLAUDE.md")
"""
The names a directory's own guidance is looked for under, in the order they win.

**One file per directory, first name wins**, rather than both concatenated. A repository carrying
both is carrying one set of instructions twice, and reading the pair puts it into the context window
twice. `AGENTS.md` leads because it is the name the ecosystem converged on and the one a repository
is most likely to keep current.
"""

GUIDANCE_DIRECTORY = "guidance"
"""
Where the console's own guidance lives under its config home, beside `config.yaml`.

A directory of files rather than one file, because that is how doctrine is *authored*: one topic
apiece, each a thing another can cite by name. Where a file is scoped is its own frontmatter's to
say, with `paths:`, and not where it sits in the directory.
"""

CONFIG_HOME = "MAINPLATE_CONFIG_HOME"
"""Where the operator's own files are, said in the environment by whatever ran this."""


def readable(path: Path) -> str | None:
    """
    What one of the operator's own files says, or nothing where it cannot be read as text.

    Nothing rather than a raise, because every caller here is answering "what has this console been
    told", and a file that is unreadable this second is not a reason a session cannot be answered.

    **The operator's files only.** This follows links, which is right for a guidance directory that
    is itself a link into somebody's dotfiles, and is exactly wrong for anything inside a worktree;
    see `beneath` for those.
    """
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None


def beneath(root: Path, relative: Path) -> bytes | None:
    """
    What a regular file inside a worktree holds, reached without following a single link.

    **Everything in a worktree is the session's to write, and this plugin reads as the operator**,
    outside every sandbox. So a path taken out of a worktree is walked one directory at a time with
    `O_NOFOLLOW`, and the file at the end is opened the same way and read only if it is a regular
    file. A link anywhere on the way is nothing rather than a file somewhere else: `docs/AGENTS.md`
    committed as a link to one of the operator's own files would otherwise be read as the operator
    and handed to the model as instructions, and so would one reached through a `docs` that is a link
    to a directory. Walking descriptors rather than checking a path and then reading it leaves no
    moment between the check and the read for the session to swap a link in.

    `O_NONBLOCK` because a session can commit a FIFO as easily as a file, and opening one to read
    waits for a writer that never comes; the check that follows refuses it before any read.

    Nothing rather than a raise, for `readable`'s reason. `root` itself is trusted: it is the
    directory this console planted, and a session cannot move a mount point.
    """
    parts = relative.parts
    if not parts or relative.is_absolute() or any(part in ("", ".", "..") for part in parts):
        return None
    try:
        at = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    except OSError:
        return None
    try:
        for part in parts[:-1]:
            inner = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=at)
            os.close(at)
            at = inner
        opened = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=at)
    except OSError:
        return None
    finally:
        os.close(at)
    with os.fdopen(opened, "rb") as held:
        if not stat.S_ISREG(os.fstat(held.fileno()).st_mode):
            return None
        return held.read()


def readable_beneath(root: Path, relative: Path) -> str | None:
    """What a guidance file inside a worktree says, reached as `beneath` reaches it."""
    held = beneath(root, relative)
    if held is None:
        return None
    try:
        return held.decode("utf-8")
    except UnicodeDecodeError:
        return None


def split_frontmatter(text: str) -> tuple[str | None, str]:
    """
    A guidance file as its opening block and its prose, with no block where it opens with prose.

    One reading of where a block ends rather than two, because the two callers below ask opposite
    halves of one question and a pair that answered it separately could come to disagree about which
    document has one at all.

    Only a block that *opens* the file counts, and only one that closes, so a document whose first
    line happens to be a rule of dashes is left exactly as it was written.
    """
    if not text.startswith("---\n"):
        return None, text
    closed = text.find("\n---", 3)
    if closed == -1:
        return None, text
    return text[4:closed], text[closed:].removeprefix("\n---").lstrip("\n")


def frontmatter(text: str) -> str | None:
    """The block a guidance file opens with, or nothing where it opens with prose."""
    return split_frontmatter(text)[0]


def without_frontmatter(text: str) -> str:
    """
    A guidance file's prose, with a leading block taken off.

    Frontmatter is addressed to whatever loads the file rather than to the model, so passing it on
    spends a context window on a `paths:` list this plugin has already acted on and invites the model
    to answer about it.
    """
    return split_frontmatter(text)[1]


def described(text: str) -> str | None:
    """
    What a guidance file says it is about, in one line, for the index that lists it.

    Authored rather than generated: a summary this console wrote would be a second copy of the file
    that drifts the moment somebody edits it, where a `description` in the file's own frontmatter is
    a thing its author kept current with the rest of it. Absent is the ordinary answer, since most
    `AGENTS.md` files in the world carry no frontmatter at all.

    **A line reader and not a YAML parser**, which is the cost of a plugin with no dependencies.
    What it understands is `description:` at the top level, quoted or bare, on one line; a folded
    block or a nested mapping reads as absent, and absent is a row with no summary rather than a
    failure. Anything else there is a repository's business and none of this plugin's.
    """
    block = frontmatter(text)
    if block is None:
        return None
    for line in block.splitlines():
        if not line.startswith("description:"):
            continue
        said = line.removeprefix("description:").strip()
        if len(said) >= 2 and said[0] == said[-1] and said[0] in "\"'":
            said = said[1:-1]
        return said.strip() or None
    return None


def tracked_guidance(root: Path) -> frozenset[Path]:
    """
    Every guidance path the worktree's index lists, relative to the repository root.

    Ignored and other untracked files may belong to an environment rather than the repository, so
    none of them may become instructions merely because a tool reached into them: a guidance file
    installed inside a `.venv` is not the repository's. `--cached` asks only what the index knows.

    **The index is the session's to write, so it is a filter and not a boundary.** A session can
    stage whatever it likes, including a path whose file on disk is a link out of the worktree; what
    keeps that from reaching the operator's files is that every read of a listed path goes through
    `beneath`. What the index still buys is the `.venv` case above, which is about what a repository
    means rather than about what a session can reach.

    Nothing on a failed command, because a directory that is not a worktree has no repository-owned
    guidance to contribute.

    **The worktree's index is read through a repository this plugin made**, an empty bare one in a
    temporary directory, and never through the worktree's own `.git`. A session's worktree owns its
    `.git`: its configuration is the model's to write, and several of its keys name a program git
    runs. Git reads the configuration of whichever repository it is told is its own, so telling it
    this one means the worktree's is never read at all, whatever keys it holds. The index itself is
    copied out through `beneath` first, so an index that is a link to somebody else's is no index
    rather than theirs; one that is not an index is a failed command and so no guidance.
    """
    index = beneath(root, Path(".git", "index"))
    if index is None:
        return frozenset()
    try:
        with tempfile.TemporaryDirectory() as scratch:
            empty = Path(scratch) / "empty"
            copied = Path(scratch) / "index"
            copied.write_bytes(index)
            made = subprocess.run(("git", "init", "--quiet", "--bare", str(empty)), check=False, capture_output=True)
            if made.returncode != 0:
                return frozenset()
            listed = subprocess.run(
                ("git", "--git-dir", str(empty), "--work-tree", str(root), "ls-files", "--cached", "-z"),
                check=False,
                capture_output=True,
                env={**os.environ, "GIT_INDEX_FILE": str(copied)},
            )
    except OSError:
        return frozenset()
    if listed.returncode != 0:
        return frozenset()
    return frozenset(
        Path(os.fsdecode(path))
        for path in listed.stdout.split(b"\0")
        if path and Path(os.fsdecode(path)).name in GUIDANCE_NAMES
    )


def guidance_at(root: Path, here: Path, tracked: frozenset[Path]) -> Path | None:
    """
    The one tracked guidance file a directory holds, relative to the root, or nothing where it holds
    none it can be read from.

    Asked through `beneath`, so a name that is tracked but is a link on disk is passed over as if it
    were absent, and the next name gets its turn.
    """
    try:
        relative = here.relative_to(root)
    except ValueError:
        return None
    for name in GUIDANCE_NAMES:
        found = relative / name
        if found in tracked and beneath(root, found) is not None:
            return found
    return None


def paths_of(block: str) -> tuple[str, ...] | None:
    """
    The globs a guidance file's frontmatter scopes it to, or nothing where it is not scoped.

    Read as a line reader rather than a YAML parser, for `described`'s reason, and what it understands
    is the two shapes a `paths:` list is written in: a flow list on the key's own line, and a block
    list of `- ` items under it, each quoted or bare. Anything else under the key reads as no globs,
    which is a scoped file that never applies rather than one that always does: a scoping mistake
    should cost the operator a rule that is missing, which they can see, and not one that is present
    everywhere, which is the thing scoping was for.
    """
    lines = block.splitlines()
    for at, line in enumerate(lines):
        if not line.startswith("paths:"):
            continue
        inline = line.removeprefix("paths:").strip()
        if inline:
            items = inline.strip("[]").split(",") if inline.startswith("[") else [inline]
        else:
            items = []
            for following in lines[at + 1 :]:
                item = following.strip()
                if not item.startswith("- "):
                    break
                items.append(item.removeprefix("- "))
        return tuple(unquoted(item) for item in items if unquoted(item))
    return None


def unquoted(item: str) -> str:
    """One scalar as written, with the quotes a YAML author may have put round it taken off."""
    said = item.strip()
    if len(said) >= 2 and said[0] == said[-1] and said[0] in "\"'":
        return said[1:-1]
    return said


def expanded(pattern: str) -> tuple[str, ...]:
    """
    A glob with its braces spelled out, so `**/*.{py,rs}` is the two globs it abbreviates.

    Nested braces expand from the outside in, which is the order a shell expands them in. A brace
    that never closes is a character, as it is to a shell.
    """
    opened = pattern.find("{")
    if opened == -1:
        return (pattern,)
    depth = 0
    for at in range(opened, len(pattern)):
        if pattern[at] == "{":
            depth += 1
        elif pattern[at] == "}":
            depth -= 1
            if depth == 0:
                break
    else:
        return (pattern,)
    options, depth, start = [], 0, opened + 1
    for inner in range(opened + 1, at):
        if pattern[inner] == "{":
            depth += 1
        elif pattern[inner] == "}":
            depth -= 1
        elif pattern[inner] == "," and depth == 0:
            options.append(pattern[start:inner])
            start = inner + 1
    options.append(pattern[start:at])
    head, tail = pattern[:opened], pattern[at + 1 :]
    return tuple(each for option in options for each in expanded(f"{head}{option}{tail}"))


def compiled(pattern: str) -> re.Pattern[str]:
    """
    One brace-free glob as a regular expression over a path relative to the repository root.

    **`.gitignore`'s reading**, because it is the one a person writing these already has: a glob with
    no `/` in it names a file at any depth, so `*.py` is every Python file and `*` is every file,
    and one with a `/` is anchored at the root, so `.github/dependabot.yml` is that file and no
    other. `**/` is any number of directories including none, `**` at the end is everything under,
    `*` is anything but a `/`, and `?` is one character that is not one. Everything else is itself.
    """
    anchored = "/" in pattern.rstrip("/")
    body = pattern.strip("/")
    out, at = [], 0
    while at < len(body):
        if body.startswith("**/", at):
            out.append("(?:.*/)?")
            at += 3
        elif body.startswith("**", at):
            out.append(".*")
            at += 2
        elif body[at] == "*":
            out.append("[^/]*")
            at += 1
        elif body[at] == "?":
            out.append("[^/]")
            at += 1
        else:
            out.append(re.escape(body[at]))
            at += 1
    return re.compile(("" if anchored else "(?:.*/)?") + "".join(out))


def covers(patterns: tuple[str, ...], path: str) -> bool:
    """
    Whether a scoped file's globs take in one path, where a `!` in front of a glob takes it back out.

    A path is covered by matching any glob without a `!` and none with one, whatever order they were
    written in: `**/*` with `!**/*.md` is every file but Markdown, which is the one thing a negation
    is for, and an order-sensitive reading would make it mean something else when the two lines swap.
    """
    wanted = [each for each in patterns if not each.startswith("!")]
    refused = [each.removeprefix("!") for each in patterns if each.startswith("!")]

    def matched(globs: list[str]) -> bool:
        return any(compiled(each).fullmatch(path) for glob in globs for each in expanded(glob))

    return matched(wanted) and not matched(refused)


@dataclass(frozen=True)
class Scoped:
    """
    One of the operator's guidance files that applies only to some files, and what it says.

    `name` is the file's path under the guidance directory, which is how the model is told which one
    it is holding and how the history is asked whether it has been handed over already.
    """

    name: str
    patterns: tuple[str, ...]
    prose: str


def console_files(config_home: Path) -> tuple[tuple[str, str], ...]:
    """
    Every file the operator has written for every session, by its name under the directory.

    Sorted by path so that two consoles reading one directory compose it identically, and recursive
    so the directory can be organised without this having to be taught how.
    """
    directory = config_home / "mainplate" / GUIDANCE_DIRECTORY
    found = sorted(directory.glob("**/*.md"))
    return tuple(
        (path.relative_to(directory).as_posix(), text) for path in found if (text := readable(path)) is not None
    )


def console_guidance(files: tuple[tuple[str, str], ...]) -> str:
    """
    The operator's guidance that is not scoped, as one block of prose.

    **Whatever carries no `paths:` loads, always**, and that is the whole of the operator's standing
    doctrine: a rule that would change an answer before any file is touched cannot wait for one.
    """
    said = (without_frontmatter(text).strip() for _, text in files if paths_of(frontmatter(text) or "") is None)
    return "\n\n".join(block for block in said if block)


def scoped_guidance(files: tuple[tuple[str, str], ...]) -> tuple[Scoped, ...]:
    """
    The operator's guidance that names the files it is for, each held back until one is reached.

    **Scoped, rather than sent to every session whole**, because most of it is about kinds of file a
    given session never touches: a rule for `Cargo.toml` and one for a Helm chart spend every
    request's context in a Python repository, and a directory of them outweighs the repository's own
    `AGENTS.md` by several times. The cost, stated: a scoped rule arrives on the request *after* the
    call that reached a file it covers, so the model has read that one file without it; and a file
    touched only through `bash` never brings one at all, since a command's paths are the model's
    string and not this plugin's to parse. Both are the price nested `AGENTS.md` delivery already
    pays, and the index is what tells the model these exist before either.
    """
    held = []
    for name, text in files:
        patterns = paths_of(frontmatter(text) or "")
        if patterns is None:
            continue
        prose = without_frontmatter(text).strip()
        if prose:
            held.append(Scoped(name=name, patterns=patterns, prose=prose))
    return tuple(held)


def scoped_index(scoped: tuple[Scoped, ...]) -> str | None:
    """
    One line per scoped file of the operator's, naming the files it covers, and nothing where there
    are none.

    The same shape as the index of a repository's nested guidance, for the same reason: that a kind
    of file has rules is one line, and what they are is a page delivered when it is wanted. The model
    cannot open these itself, since they are the operator's and not in any worktree, so the line
    says they arrive rather than inviting a read.
    """
    if not scoped:
        return None
    rows = [f"- `{each.name}`: {', '.join(f'`{glob}`' for glob in each.patterns)}" for each in scoped]
    return "\n".join(
        (
            "The operator has guidance for particular kinds of file, handed to you the first time a "
            "file tool names a file it covers:",
            "",
            *rows,
        )
    )


def repository_guidance(root: Path, tracked: frozenset[Path]) -> str | None:
    """
    What the repository says about itself, named so the model knows whose words these are.

    The name is carried into the text rather than left implicit, because the model can open the file
    and should know which one it is already holding. It is also what keeps the block honest about
    being the project's rather than this console's, which matters where the two disagree.
    """
    found = guidance_at(root, root, tracked)
    if found is None:
        return None
    said = readable_beneath(root, found)
    if said is None:
        return None
    body = without_frontmatter(said).strip()
    return f"`{found.name}`, this repository's own guidance:\n\n{body}" if body else None


def elsewhere_in(tracked: frozenset[Path]) -> tuple[Path, ...]:
    """
    Every tracked guidance file below the repository root, as a relative path.

    Sorted, so an index composed twice is the same index. The root's own file is left out because it
    is already in the instructions whole; what this is for is the ones that are not.

    **One file per directory, the same first-name-wins rule `guidance_at` applies.** A repository
    that pairs an `AGENTS.md` with a `CLAUDE.md` importing it - which is how mainplate itself wires
    Claude Code to the file every other harness reads - would otherwise index each directory twice,
    and the second row would point at a file whose whole content is a line naming the first.
    """
    directories = {path.parent for path in tracked if path.parent != Path()}
    found = []
    for directory in directories:
        for name in GUIDANCE_NAMES:
            candidate = directory / name
            if candidate in tracked:
                found.append(candidate)
                break
    return tuple(sorted(found))


def indexing(root: Path, found: tuple[Path, ...]) -> str | None:
    """
    One line per guidance file elsewhere in the repository, and nothing where there are none.

    **The index is identity and the file is the content**, which is the whole shape of this: that
    `apps/web` has conventions is one line and what they are is a page, so the line rides in the
    instructions on every request and the page is read when it is wanted. It is also the half that
    serves the goal path scoping never did, which is knowing that a part of the repository *has*
    rules before reaching into it and breaking them.

    Nothing where a repository has none, which is most of them: a heading over an empty list reports
    a feature rather than a fact.
    """
    rows = []
    for each in found:
        text = readable_beneath(root, each)
        said = None if text is None else described(text)
        rows.append(f"- `{each}`{f': {said}' if said else ''}")
    if not rows:
        return None
    return "\n".join(
        (
            "Other parts of this repository carry their own guidance. Read the one covering a "
            "directory before you change much in it:",
            "",
            *rows,
        )
    )


def heading(found: Path) -> str:
    """
    The line a delivered block opens with, which is also how a later request knows it was delivered.

    One string built in one place, because it is read back: the predicate below asks whether the
    model has already been handed this file, and it answers by looking for this exact line in what
    the model will be handed. Built at both ends separately they would drift and every approach would
    deliver the same guidance again.
    """
    return f"`{found}`, guidance for this part of the repository:"


def scoped_heading(scoped: Scoped) -> str:
    """
    The line a delivered scoped file of the operator's opens with, read back as `heading` is.

    Its name alone and not its globs, so an operator widening what a file covers mid-conversation
    does not make the history forget it was already handed over.
    """
    return f"`{scoped.name}`, the operator's guidance for the files it covers:"


def touched_in(messages: list[Any]) -> tuple[str, ...]:
    """
    Every path the model has named to a file tool, in the order it named them.

    Read off the calls rather than off anything recorded beside them, which is what makes this free:
    a call is already in the history for its own sake. A call naming a `root` is passed over, since
    the only root that is not the worktree is the scratch and nothing there is the repository's.

    `bash` is not here and cannot be: its argv is the model's, so a path inside it is a string this
    plugin has no business parsing. That is the hole the index exists to cover.
    """
    found: list[str] = []
    for message in messages:
        if not isinstance(message, dict) or message.get("kind") != "response":
            continue
        for part in message.get("parts") or []:
            if not isinstance(part, dict) or part.get("part_kind") != "tool-call":
                continue
            arguments = part.get("args")
            if isinstance(arguments, str):
                try:
                    arguments = json.loads(arguments)
                except json.JSONDecodeError:
                    continue
            if not isinstance(arguments, dict):
                continue
            path = arguments.get("path")
            if isinstance(path, str) and not arguments.get("root"):
                found.append(path)
    return tuple(found)


def system_prompts_in(messages: list[Any]) -> tuple[str, ...]:
    """
    Every system-voice part the history carries, gathered in one walk of it.

    **The history is the ledger**, which is what makes a set kept anywhere else wrong rather than
    merely redundant: one on the session would survive a `forget` and leave the model working without
    guidance it can no longer see, and one on the pass would deliver again on every pass. Asked here,
    every case answers itself - the console delivered it, the model read the file for itself, the
    model wrote the file, a fork carried it across, a forget dropped it.

    Gathered once rather than searched per question, because the questions are one per directory
    between a reached file and the root and the history grows for the whole conversation: walking it
    per pair is the same answer recomputed until a long session pays for it on every request.
    """
    found: list[str] = []
    for message in messages:
        if not isinstance(message, dict) or message.get("kind") != "request":
            continue
        for part in message.get("parts") or []:
            if not isinstance(part, dict) or part.get("part_kind") != "system-prompt":
                continue
            content = part.get("content")
            if isinstance(content, str):
                found.append(content)
    return tuple(found)


def delivered_in(prompts: tuple[str, ...], said: str) -> bool:
    """Whether the model has already been handed this, asked of what it has already been told."""
    return any(prompt.startswith(said) for prompt in prompts)


def covering(settled: Path, here: Path, tracked: frozenset[Path]) -> tuple[Path, ...]:
    """
    The guidance files that apply inside one directory, from the top down, relative to the root.

    The repository's own root file is left out because it is already in the instructions whole. What
    is left is every directory between there and the file, which is the ecosystem's own reading of
    nested `AGENTS.md` and is why nesting needs no mechanism of this console's: a repository states
    which of its rules are local by where it puts them.

    **Asked of the directory rather than of the file**, and of a resolved one, which is what makes
    the answer worth remembering: this is two `is_file` calls per directory up to the root and every
    file in one has the same answer, so a caller reading fifteen files in a directory walks it once.
    Resolved, because a symlinked file's guidance is its target's, so two names that look like one
    directory can be two.

    A directory outside the repository yields nothing rather than raising. It cannot arrive from a
    tool, which refuses one long before this, but this reads what a model wrote and a value that
    cannot happen is not one to crash on.

    **Walked downward from the root rather than upward from the directory**, which is the only reading
    that stops at the root: a walk up the parents runs past it, and the directory holding the
    repository is somebody else's - a checkout inside a checkout, or a worktree planted under the
    clone it came from, in which case the next `AGENTS.md` up is a file this session was never given
    and has no name relative to its root.
    """
    if settled != here and settled not in here.parents:
        return ()
    found: list[Path] = []
    at = settled
    for part in here.relative_to(settled).parts:
        at = at / part
        guidance = guidance_at(settled, at, tracked)
        if guidance is not None:
            found.append(guidance)
    return tuple(found)


def approaching(root: Path, messages: list[Any], scoped: tuple[Scoped, ...] = ()) -> tuple[str, ...]:
    """
    What to hand the model, given where it has been reaching and what it has already been told.

    Two kinds of block, in the order `instructing` composes their scopes: the operator's scoped files
    covering a reached path first, then the repository's nested guidance above it, so where the two
    disagree the repository has the last word here too.

    Delivered on the request *after* the calls that reached in, which is the same round trip the tool
    results themselves arrive on: there is no earlier moment, since a batch of calls and the reply to
    them are one exchange. So the model has read one file without the local guidance and has not yet
    done the next fifteen things.

    Each question is asked once. The history is walked once for what has been delivered; a path the
    model reached for twice is considered once, in the order it was first named; the directories above
    one are walked once per directory; and a file settled here is marked whether or not it produced a
    block, so a guidance file already delivered is not reconsidered on every later read beneath it.
    Without that this recomputes an answer it already has, once per tool call, on every request of a
    conversation that only gets longer.
    """
    settled = root.resolve()
    prompts = system_prompts_in(messages)
    tracked = tracked_guidance(root)
    nested: dict[Path, tuple[Path, ...]] = {}
    blocks: list[str] = []
    said: set[Path] = set()
    handed: set[str] = set()
    for path in dict.fromkeys(touched_in(messages)):
        reached = (root / path).resolve()
        if reached != settled and settled not in reached.parents:
            continue
        relative = reached.relative_to(settled).as_posix()
        for each in scoped:
            if each.name in handed or not covers(each.patterns, relative):
                continue
            handed.add(each.name)
            if not delivered_in(prompts, scoped_heading(each)):
                blocks.append(f"{scoped_heading(each)}\n\n{each.prose}")
        here = reached.parent
        if here not in nested:
            nested[here] = covering(settled, here, tracked)
        for found in nested[here]:
            if found in said:
                continue
            said.add(found)
            if delivered_in(prompts, heading(found)):
                continue
            body = readable_beneath(settled, found)
            if body is None:
                continue
            prose = without_frontmatter(body).strip()
            if not prose:
                continue
            blocks.append(f"{heading(found)}\n\n{prose}")
    return tuple(blocks)


def instructing(*blocks: str | None) -> str:
    """
    What this plugin contributes to what a session is answered under, from every scope with something
    to say.

    In order of increasing specificity, so the last word belongs to whatever is most local. Empty
    blocks are dropped rather than joined, so a console with no guidance and a repository with no
    `AGENTS.md` contribute nothing at all rather than a run of blank lines.
    """
    return "\n\n".join(block.strip() for block in blocks if block and block.strip())


def describing(payload: dict[str, Any]) -> dict[str, Any]:
    """
    What this plugin is, and what it has to say about this session before its first request.

    **`instructions` is a `setup` contribution rather than an event**, and that is the cache
    rather than tidiness: instructions sit in front of the cached prefix, so composing them again on
    a later turn would re-price every remaining request the moment the repository's own `AGENTS.md`
    moved - and a session working on a repository's guidance moves it constantly. Reading it again
    buys nothing against that, because the thing most likely to have edited the file is the model,
    which knows what it wrote.
    """
    files = operators_files()
    where = payload.get("worktree")
    root = Path(where) if isinstance(where, str) else None
    tracked = tracked_guidance(root) if root is not None else frozenset()
    said = instructing(
        console_guidance(files),
        # Only where there is a worktree, since a file tool naming a file in one is the only thing
        # that hands a scoped file over: an index promising what never arrives is worse than none.
        scoped_index(scoped_guidance(files)) if root is not None else None,
        repository_guidance(root, tracked) if root is not None else None,
        indexing(root, elsewhere_in(tracked)) if root is not None else None,
    )
    return {
        # Only where there is a worktree to reach into. A session with no repository has no nested
        # guidance to hand over, so asking it at every request would be a process per request to be
        # told nothing.
        "events": ["before_request"] if root is not None else [],
        **({"instructions": said} if said else {}),
    }


def answer(payload: dict[str, Any]) -> dict[str, Any]:
    """What this plugin wants done about one event, which for most events is nothing."""
    event = payload.get("event")
    if event == "setup":
        return describing(payload)
    if event == "before_request":
        where = payload.get("worktree")
        if not isinstance(where, str):
            return {}
        messages = payload.get("messages")
        said = approaching(
            Path(where), messages if isinstance(messages, list) else [], scoped_guidance(operators_files())
        )
        return {"inject": list(said)} if said else {}
    return {}


def operators_files() -> tuple[tuple[str, str], ...]:
    """
    The operator's guidance files, read afresh, or none where this console was told of no config home.

    Read at every event that wants them rather than carried from `setup`, because a plugin keeps
    nothing between events but what it asks to `set`, and a directory of prose is not worth a
    session's state to save a few small reads per request.
    """
    home = os.environ.get(CONFIG_HOME)
    return console_files(Path(home)) if home else ()


def main() -> int:
    json.dump(answer(json.load(sys.stdin)), sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
